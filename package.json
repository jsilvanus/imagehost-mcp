{
  "name": "imagehost-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Personal image library and MCP server bridging photo capture, organization, and AI agents",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "pnpm -C web build",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "worker:retention": "tsx src/workers/run-retention.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/sensible": "^6.0.2",
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.40.0",
    "fastify": "^5.2.1",
    "jose": "^6.0.8",
    "openid-client": "^6.3.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "sharp": "^0.33.5",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.5",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
