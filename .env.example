PORT=3000
HOST=0.0.0.0
NODE_ENV=development
BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://imagehost_user:imagehost_pass@localhost:5432/imagehost

# Storage (S3 / MinIO / VersityGW)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=imagehost
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword
S3_FORCE_PATH_STYLE=true

# Auth & Identity (Tunnus OIDC)
OIDC_ISSUER_URL=https://kehitys.riihimaenseurakunta.fi/identity
OIDC_CLIENT_ID=kuvarasto
OIDC_CLIENT_SECRET=
SESSION_SECRET=a_very_secret_key_at_least_32_characters_long_for_session

# Image Limits & Retention
IMAGE_MAX_UPLOAD_BYTES=26214400 # 25MB
IMAGE_MAX_PIXELS=50000000 # 50 Megapixels
DEFAULT_DELETION_RETENTION_HOURS=72 # 3 days retention before permanent deletion
SIGNED_URL_TTL_SECONDS=3600 # 1 hour fixed
